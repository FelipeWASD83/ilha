<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 26100: a projeção WinRT precisa do FocusSessionManager (UniversalApiContract 15) -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF só pelo System.Windows.Automation (ponte com o app do Claude); nenhuma janela WPF é obrigatória -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>Ilha</AssemblyName>
    <RootNamespace>Ilha</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003;CA1416</NoWarn>
    <Version>1.0.3</Version>
    <ApplicationIcon>..\..\icone\icone.ico</ApplicationIcon>
    <Product>Ilha</Product>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="imagens\**\*" Exclude="imagens\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\sons\*.wav" Link="sons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="animacoes.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\icone\icone.ico" Link="icone.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Wrappers gerenciados sobre d3d11.dll, d2d1.dll e dwrite.dll do sistema: nenhuma DLL nativa de terceiro -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <!-- optional private modules (local.props is not in git); the public release build skips it -->
  <Import Project="local.props" Condition="Exists('local.props') And '$(PublicBuild)' != 'true'" />
</Project>
